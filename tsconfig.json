{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "packages/codex-adapter/test/**/*.ts",
    "packages/roots/test/**/*.ts",
    "packages/gauge-errors/test/**/*.ts",
    "packages/core-api/test/**/*.ts",
    "packages/gauge-manifest/test/**/*.ts",
    "packages/gauge-layout/test/**/*.ts",
    "packages/engine-sessions/test/**/*.ts",
    "packages/jobs/test/**/*.ts"
  ]
}
